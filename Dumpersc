local function addEntry(method, remote, args)
    entryCount += 1
    CountTxt.Text = entryCount.." remotes"

    -- cap: hapus entry terlama
    if #entries >= MAX_ENTRIES then
        local old = table.remove(entries,1)
        if old.row then old.row:Destroy() end
    end

    local serializedArgs = {}
    for _,v in ipairs(args) do
        table.insert(serializedArgs, {raw=v, serialized=serializeArg(v)})
    end

    local fullPath  = remote:GetFullName()
    local shortName = remote.Name
    local col       = methodColors[method] or T.TextPrimary

    local entry = {
