-- Logika Dumper Universal
local function startUniversalDump()
    DumpBtn.Text = "Memindai..."
    local dumpCount = 0
    local fileName = "ZHub_UniversalDump_" .. os.time() .. ".txt"
    local logs = {"--- ZHUB DECOMPILE SCRIPT V1 ---"}

    local function writeLog(txt)
        table.insert(logs, txt)
        pcall(function()
            writefile(fileName, table.concat(logs, "\n"))
        end)
    end

    local function scan(parent)
        for _, obj in ipairs(parent:GetDescendants()) do
            pcall(function()
                if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                    dumpCount += 1
                    StatusLabel.Text = "Proses: " .. obj.Name
                    table.insert(logs, "\n-- [ PATH: " .. obj:GetFullName() .." ] --")
                    
                    if decompile then
                        local success, res = pcall(function() return decompile(obj) end)
                        if success and res then
                            table.insert(logs, res)
                        else
                            table.insert(logs, "-- [!] Gagal dekompilasi script.")
                        end
                    else
                        table.insert(logs, "-- [!] Executor tidak support decompile().")
                    end
                end
            end)
        end
    end

    pcall(function()
        scan(PlayerGui)
        scan(game:GetService("ReplicatedStorage"))
        scan(game:GetService("StarterGui"))
    end)

    writeLog("\n--- SELESAI. Total Script: " .. dumpCount .. " ---")
    StatusLabel.Text = "Berhasil! Cek file: " .. fileName
    DumpBtn.Text = "✔ Selesai Di-dump"
end

DumpBtn.MouseButton1Click:Connect(startUniversalDump)
