        if c:IsA("TextButton") then c:Destroy() end
    end

    for _, entry in ipairs(entries) do
        if filterQuery == "" or entry.name:lower():find(filterQuery:lower()) or entry.method:lower():find(filterQuery:lower()) then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.BackgroundColor3 = (selectedEntry == entry) and T.CardHover or T.Surface
            btn.Text = ""
