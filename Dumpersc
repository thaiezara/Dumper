-- =====================================================================
-- ARG SERIALIZER — handle semua tipe termasuk buffer
-- =====================================================================
local function serializeArg(v, depth)
    depth = depth or 0
    if depth > 3 then return "..." end
    local t = typeof(v)

    if t == "buffer" then
        local len = buffer.len(v)
        local hex = {}
        for i = 0, math.min(len-1, 63) do
            table.insert(hex, string.format("%02X", buffer.readu8(v,i)))
        end
        local suffix = len > 64 and ("...(+"..len-64.." bytes)") or ""
        return string.format("buffer[%d] { %s%s }", len, table.concat(hex," "), suffix)

    elseif t == "Instance" then
        return string.format("Instance<%s> \"%s\"", v.ClassName, v:GetFullName())

    elseif t == "table" then
        if depth >= 2 then return "table{...}" end
        local parts = {}
        local count = 0
        for k,val in pairs(v) do
            count += 1
            if count > 8 then table.insert(parts,"..."); break end
            table.insert(parts, tostring(k).."="..serializeArg(val, depth+1))
        end
        return "table{"..table.concat(parts,", ").."}"

    elseif t == "Vector3" then
        return string.format("Vector3(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z)

    elseif t == "Vector2" then
        return string.format("Vector2(%.3f, %.3f)", v.X, v.Y)

    elseif t == "CFrame" then
        return string.format("CFrame(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z)

    elseif t == "Color3" then
        return string.format("Color3(%.2f, %.2f, %.2f)", v.R, v.G, v.B)

    elseif t == "BrickColor" then
        return "BrickColor(\""..v.Name.."\")"

    elseif t == "EnumItem" then
        return "Enum."..tostring(v)

    elseif t == "boolean" then
        return v and "true" or "false"

    elseif t == "nil" then
        return "nil"

    elseif t == "number" then
        if v == math.huge then return "math.huge"
        elseif v == -math.huge then return "-math.huge"
        elseif v ~= v then return "NaN"
        elseif math.floor(v) == v then return tostring(math.floor(v))
        else return string.format("%.6g", v) end

    elseif t == "string" then
        if #v > 80 then return string.format('"%s..." [%d chars]', v:sub(1,80), #v) end
        return string.format('"%s"', v)

    else
        return string.format("%s(%s)", t, tostring(v))
    end
end

-- build full script string untuk satu remote call
local function buildScript(remotePath, method, args)
    local lines = {}
    table.insert(lines, "-- ZarVerse Spy — Generated Script")
    table.insert(lines, string.format("local remote = game:GetService(\"ReplicatedStorage\"):FindFirstChild(\"%s\", true)", remotePath:match("[^%.]+$") or remotePath))
    table.insert(lines, string.format("-- Full path: %s", remotePath))

    local argStrings = {}
    for _,v in ipairs(args) do
        table.insert(argStrings, serializeArg(v))
    end

    table.insert(lines, string.format("remote:%s(%s)", method, table.concat(argStrings, ", ")))
    return table.concat(lines, "\n")
end

