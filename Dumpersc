    clickBtn.ZIndex = 14; clickBtn.Parent = row
    clickBtn.MouseButton1Click:Connect(function() showDetail(entry) end)
    row.MouseEnter:Connect(function() tw(row,{BackgroundColor3=T.CardHover}) end)
    row.MouseLeave:Connect(function() tw(row,{BackgroundColor3=T.Card}) end)

    -- apply filter visibility
    local q = filterQuery:lower()
    row.Visible = (q=="" or shortName:lower():find(q,1,true) or fullPath:lower():find(q,1,true) or method:lower():find(q,1,true))

    entry.row = row
    table.insert(entries, entry)

    -- auto scroll list
