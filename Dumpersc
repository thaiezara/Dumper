local function showDetail(entry)
    selectedEntry = entry
    clearDetail()
    DetailTitle.Text = entry.method .. " → " .. entry.name
    CopyScriptBtn.Visible = true

    local methodBadge = Instance.new("Frame")
    methodBadge.Size = UDim2.new(1, 0, 0, 28)
    methodBadge.BackgroundColor3 = T.Surface
    methodBadge.BorderSizePixel = 0
    methodBadge.ZIndex = 13
    methodBadge.LayoutOrder = 0
    methodBadge.Parent = DetailScroll
    corner(methodBadge, 6)

    local ml = Instance.new("TextLabel")
    ml.Size = UDim2.new(1, -10, 1, 0)
    ml.Position = UDim2.new(0, 10, 0, 0)
    ml.BackgroundTransparency = 1
    ml.TextColor3 = methodColors[entry.method] or T.TextPrimary
    ml.Text = "🔵 " .. entry.method .. "  |  " .. entry.fullPath
    ml.TextSize = 10
    ml.Font = Enum.Font.GothamBold
    ml.TextXAlignment = Enum.TextXAlignment.Left
    ml.ZIndex = 14
    ml.Parent = methodBadge

    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.new(1, 0, 0, 14)
    tl.BackgroundTransparency = 1
    tl.Text = "⏱ " .. entry.time .. "  |  Call #" .. entry.id
    tl.TextColor3 = T.TextMuted
    tl.TextSize = 9
    tl.Font = Enum.Font.Gotham
    tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.ZIndex = 13
    tl.LayoutOrder = 1
    tl.Parent = DetailScroll

    if #entry.args == 0 then
        local noArg = Instance.new("TextLabel")
        noArg.Size = UDim2.new(1, 0, 0, 20)
        noArg.BackgroundTransparency = 1
        noArg.Text = "  (no arguments)"
        noArg.TextColor3 = T.TextMuted
        noArg.TextSize = 10
        noArg.Font = Enum.Font.Code
        noArg.TextXAlignment = Enum.TextXAlignment.Left
        noArg.ZIndex = 13
        noArg.LayoutOrder = 2
        noArg.Parent = DetailScroll
    else
        for i, arg in ipairs(entry.args) do
            local argFrame = Instance.new("Frame")
            argFrame.Size = UDim2.new(1, 0, 0, 0)
            argFrame.AutomaticSize = Enum.AutomaticSize.Y
            argFrame.BackgroundColor3 = T.Surface
            argFrame.BorderSizePixel = 0
            argFrame.ZIndex = 13
            argFrame.LayoutOrder = i + 1
            argFrame.Parent = DetailScroll
            corner(argFrame, 6)

            local argLabel = Instance.new("TextLabel")
            argLabel.Size = UDim2.new(1, -10, 0, 0)
            argLabel.AutomaticSize = Enum.AutomaticSize.Y
            argLabel.Position = UDim2.new(0, 8, 0, 4)
            argLabel.BackgroundTransparency = 1
            argLabel.Text = string.format("[%d] (%s)\n%s", i, typeof(arg.raw), arg.serialized)
            argLabel.TextColor3 = T.TextPrimary
            argLabel.TextSize = 10
            argLabel.Font = Enum.Font.Code
            argLabel.TextXAlignment = Enum.TextXAlignment.Left
            argLabel.TextWrapped = true
            argLabel.ZIndex = 14
            argLabel.Parent = argFrame
        end
    end
end

