local function clearDetail()
    for _, c in ipairs(DetailScroll:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
    end
    DetailTitle.Text = "Pilih remote di kiri"
    CopyScriptBtn.Visible = false
