-- save
SaveBtn.MouseButton1Click:Connect(function()
    local lines={}
    for _,entry in ipairs(entries) do
        table.insert(lines,"["..entry.time.."] "..entry.method.." → "..entry.fullPath)
        for i,arg in ipairs(entry.args) do
            table.insert(lines,"  ["..i.."] "..arg.serialized)
        end
        table.insert(lines,"")
    end
    local fname="ZarVerseSpy_"..os.time()..".txt"
    pcall(writefile,fname,table.concat(lines,"\n"))
    SaveBtn.Text="✓ Saved!"
    task.delay(1.5,function() SaveBtn.Text="💾 Save" end)
end)

-- =====================================================================
-- HOOK — intercept semua method
-- =====================================================================
local hookMethods = {
    "FireServer", "InvokeServer",
    "FireClient", "FireAllClients", "InvokeClient"
}

local hookOk = pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()

        -- cek apakah method yang mau di-spy
        local shouldSpy = false
        for _,m in ipairs(hookMethods) do
            if method == m then shouldSpy = true; break end
        end

        if shouldSpy and not isPaused then
            pcall(function()
                local args = {...}
                -- filter: kalau self adalah RemoteEvent atau RemoteFunction
                if self:IsA("RemoteEvent") or self:IsA("RemoteFunction")
                or self:IsA("BindableEvent") or self:IsA("BindableFunction") then
                    addEntry(method, self, args)
                end
            end)
        end

        return oldNamecall(self, ...)
    end)
end)

