local function logRemote(method, selfObj, args)
    if isPaused then return end
    if not selfObj then return end

    local fullName = ""
    pcall(function() fullName = selfObj:GetFullName() end)
    if fullName == "" then fullName = tostring(selfObj) end

    entryCount += 1
    local serializedArgs = {}
    for _, arg in ipairs(args) do
        table.insert(serializedArgs, {
            raw = arg,
            serialized = serializeArg(arg)
        })
    end

    local entry = {
        id = entryCount,
        method = method,
        name = selfObj.Name or "Unknown",
        fullPath = fullName,
        time = os.date("%H:%M:%S"),
        args = serializedArgs,
        rawArgs = args
    }

    table.insert(entries, 1, entry)
    if #entries > MAX_ENTRIES then
        table.remove(entries)
    end

    CountTxt.Text = entryCount .. " remotes"
    rebuildList()
end

